[globcfg]
base_address = 0x12001000
data_width = 16
address_width = 32
address_alignment = data_width
force_name_case = none

[c_header]
path = ./generated/vera_spr_attr_ram.h
prefix = VERA_SPRITE_ATTR
generator = ./generators/c_nocstd_generator.py::CHeaderNoCstd

[md_doc]
path = ../docs/registers/vera-spr-attr-ram.md
title = VERA Sprite Attribute RAM layout
print_images = True
image_dir = md_img
print_conventions = True
generator = ./generators/markdown_generator.py::Markdown

[asm]
path = ./generated/vera_spr_attr_ram.s
prefix = VERA_SPRITE_ATTR
generator = ./generators/asm_generator.py::AsmGenerator

[forth]
path = ../fs/forth/vera_spr_attr_ram.fs
prefix = VERA_SPRITE_ATTR
generator = ./generators/forth_generator.py::ForthGenerator

