[globcfg]
base_address = 0x100000D0
data_width = 32
address_width = 32
address_alignment = data_width
force_name_case = none

[c_header]
path = ./generated/reset_regs.h
prefix = RESET
generator = ./generators/c_nocstd_generator.py::CHeaderNoCstd

[md_doc]
path = ../docs/registers/reset-regs.md
title = Reset Register map
print_images = True
image_dir = md_img
print_conventions = True
generator = ./generators/markdown_generator.py::Markdown

[asm]
path = ./generated/reset_regs.s
prefix = RESET
generator = ./generators/asm_generator.py::AsmGenerator

[forth]
path = ../fs/forth/reset_regs.fs
prefix = RESET
generator = ./generators/forth_generator.py::ForthGenerator
