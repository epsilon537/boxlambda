[globcfg]
base_address = 0x10000040
data_width = 32
address_width = 32
address_alignment = data_width
force_name_case = none

[c_header]
path = ./generated/usb_hid_0_regs.h
prefix = USB_HID_0
generator = ./generators/c_nocstd_generator.py::CHeaderNoCstd

[md_doc]
path = ../docs/registers/usb-hid-0-regs.md
title = USB HID 0 Register map
print_images = True
image_dir = md_img
print_conventions = True
generator = ./generators/markdown_generator.py::Markdown

[asm]
path = ./generated/usb_hid_0_regs.s
prefix = USB_HID_0
generator = ./generators/asm_generator.py::AsmGenerator

[forth]
path = ../fs/forth/usb_hid_0_regs.fs
prefix = USB_HID_0
generator = ./generators/forth_generator.py::ForthGenerator
